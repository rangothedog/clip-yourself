<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Clip Yourself"
           Manufacturer="clipyourself.com"
           Version="0.1.0"
           UpgradeCode="7c1e4b0a-3f5d-4a19-9c64-2b8d0af3e7c1"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Clip Yourself is already installed."/>
    <MediaTemplate EmbedCab="yes"/>

    <Icon Id="AppIcon" SourceFile="..\src\ClipYourself.Desktop\Assets\Clipyourself.ico"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Clip Yourself"/>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder"/>

    <Feature Id="Main" Title="Clip Yourself">
      <Files Include="$(var.PublishDir)\**"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
      <Shortcut Id="AppStartMenuShortcut"
                Name="Clip Yourself"
                Description="Sidebar clipboard manager for text, images, and sound"
                Target="[INSTALLFOLDER]ClipYourself.Desktop.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon"/>
      <RegistryValue Root="HKCU" Key="Software\ClipYourself" Name="StartMenuShortcut"
                     Type="integer" Value="1" KeyPath="yes"/>
    </Component>
  </Package>
</Wix>
