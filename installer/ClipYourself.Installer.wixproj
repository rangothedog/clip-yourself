<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>ClipYourself-0.1.0-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressSpecificWarnings>1118</SuppressSpecificWarnings>
    <!-- Points at the self-contained publish output; run scripts/build-installer.ps1 to produce it -->
    <DefineConstants>PublishDir=..\src\ClipYourself.Desktop\bin\Release\net8.0-windows\win-x64\publish</DefineConstants>
  </PropertyGroup>
</Project>
