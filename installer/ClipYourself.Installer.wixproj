<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>ClipYourself-1.0.3-win-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <SuppressSpecificWarnings>1118</SuppressSpecificWarnings>
    <!-- Points at the self-contained publish output; run scripts/build-installer.ps1 to produce it -->
    <DefineConstants>PublishDir=..\src\ClipYourself.Desktop\bin\Release\net10.0-windows\win-x64\publish</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- WixUI dialog set: license agreement + feature (desktop shortcut) selection -->
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
