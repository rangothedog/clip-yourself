<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClipYourself.Core\ClipYourself.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Clipyourself.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Embed the icon so the window and header logo can load it via pack URI -->
  <ItemGroup>
    <Resource Include="Assets\Clipyourself.ico" />
  </ItemGroup>

</Project>
