<Window x:Class="ClipYourself.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:ClipYourself.Desktop.Controls"
        mc:Ignorable="d"
        Title="Clip Yourself"
        Icon="/Assets/Clipyourself.ico"
        Width="380" MinWidth="300" Height="800"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="{StaticResource PanelBrush}"
        Topmost="{Binding AlwaysOnTop}"
        BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1,0,0,0"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">

    <Window.Resources>

        <!-- One clipboard entry, used by the sidebar list, the reel, and search results -->
        <DataTemplate x:Key="ClipCardTemplate">
            <Button Style="{StaticResource CardButton}"
                    ToolTip="Click to copy · drag onto another clip to reorder, or onto a drawer to file it"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="ClipCard_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="ClipCard_PreviewMouseMove"
                    DragOver="ClipCard_DragOver" Drop="ClipCard_Drop"
                    Command="{Binding DataContext.CopyClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="4" Padding="5,2" Margin="0,1,8,0" VerticalAlignment="Top"
                            Background="{Binding Kind, Converter={StaticResource KindBadgeBg}}">
                        <TextBlock Text="{Binding Kind, Converter={StaticResource KindBadgeText}}"
                                   FontFamily="Consolas" FontSize="9" FontWeight="Bold"
                                   Foreground="{Binding Kind, Converter={StaticResource KindBadgeFg}}"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding PreviewText}"
                                   Foreground="{StaticResource TextBrush}" FontSize="12"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="54"
                                   Visibility="{Binding Kind, Converter={StaticResource KindToVis}, ConverterParameter='Text,Files'}"/>

                        <Image Source="{Binding ImagePath, Converter={StaticResource PathToImage}}"
                               MaxHeight="130" Stretch="Uniform" HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Kind, Converter={StaticResource KindToVis}, ConverterParameter='Image'}"/>

                        <StackPanel Visibility="{Binding Kind, Converter={StaticResource KindToVis}, ConverterParameter='Audio'}">
                            <TextBlock Text="{Binding PreviewText}" FontSize="11"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <controls:WaveformPlayer Source="{Binding AudioPath}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding Kind, Converter={StaticResource KindToVis}, ConverterParameter='Video'}">
                            <TextBlock Text="{Binding PreviewText}" FontSize="11"
                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <controls:VideoPlayer Source="{Binding VideoPath}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding LastCopiedAt, Converter={StaticResource RelTime}}"
                                       FontSize="10" Foreground="{StaticResource SubTextBrush}"/>
                            <TextBlock Text="{Binding SizeBytes, Converter={StaticResource BytesToSize}}"
                                       FontSize="10" Foreground="{StaticResource SubTextBrush}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock Text="✓" FontWeight="Bold" FontSize="13" Margin="0,0,6,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"
                                   ToolTip="Selected — drag to a drawer, or press Delete"
                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="📌" Width="22" Height="22" FontSize="10"
                                ToolTip="Pin (stays on top, never auto-evicted)"
                                Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="✕" Style="{StaticResource DangerIconButton}"
                                Width="22" Height="22" FontSize="10"
                                ToolTip="Remove this clip"
                                Command="{Binding DataContext.DeleteClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- A search result: clip card plus the drawer it lives in -->
        <DataTemplate x:Key="SearchHitTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DrawerName}" FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="2,0,0,2"/>
                <ContentPresenter Content="{Binding Clip}" ContentTemplate="{StaticResource ClipCardTemplate}"/>
            </StackPanel>
        </DataTemplate>

        <!-- One drawer row in the "Drawers" section — the whole row opens it
             (and is a drop target for filing clips); only 🗑 is carved out. -->
        <DataTemplate x:Key="DrawerRowTemplate">
            <Button Style="{StaticResource DrawerRowButton}"
                    ToolTip="Open drawer · drag onto another drawer to reorder"
                    AllowDrop="True"
                    PreviewMouseLeftButtonDown="DrawerRow_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="DrawerRow_PreviewMouseMove"
                    DragOver="DrawerRow_DragOver" DragLeave="DrawerRow_DragLeave" Drop="DrawerRow_Drop"
                    Command="{Binding DataContext.OpenDrawerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🗂" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12"
                                   Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource SubTextBrush}">
                            <Run Text="{Binding Clips.Count, Mode=OneWay, Converter={StaticResource ClipCount}}"/><Run Text=" · "/><Run Text="{Binding CreatedAt, Converter={StaticResource RelTime}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="2" Content="🗑" Style="{StaticResource DangerIconButton}"
                            ToolTip="Delete drawer"
                            Command="{Binding DataContext.DeleteDrawerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header (drag handle) ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="12,8"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- Only floating: signal the header is a grab handle -->
                        <DataTrigger Binding="{Binding IsFloating}" Value="True">
                            <Setter Property="Cursor" Value="SizeAll"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⠿" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextBrush}" ToolTip="Drag to move the sidebar">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFloating}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Image Source="/Assets/Clipyourself.ico" Width="24" Height="24" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                    <TextBlock Text="Clip Yourself" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{Binding IsCapturePaused}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleIconButton}">
                            <Setter Property="Content" Value="⏸"/>
                            <Setter Property="ToolTip" Value="Pause clipboard capture"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="▶"/>
                                    <Setter Property="ToolTip" Value="Capture is paused — click to resume"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
                <ToggleButton Grid.Column="2" Content="📌" Style="{StaticResource ToggleIconButton}"
                              ToolTip="Keep sidebar on top"
                              IsChecked="{Binding AlwaysOnTop}"/>
                <Button Grid.Column="3" Content="⚙" Style="{StaticResource IconButton}"
                        ToolTip="Settings" Command="{Binding ToggleSettingsCommand}"/>
                <Button Grid.Column="4" Content="—" Style="{StaticResource IconButton}"
                        ToolTip="Hide (Ctrl+Alt+V to bring back)" Click="HideButton_Click"/>
            </Grid>
        </Border>

        <!-- ===== Session bar (drop target: file back into session) ===== -->
        <Border Grid.Row="1" Padding="12,10,12,6"
                AllowDrop="True" DragOver="SessionBar_DragOver" Drop="SessionBar_Drop">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox Style="{StaticResource GhostTextBox}" FontSize="13" FontWeight="SemiBold"
                                 ToolTip="Click to rename this session"
                                 Text="{Binding SessionDrawer.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock FontSize="10" Foreground="{StaticResource SubTextBrush}">
                                <Run Text="{Binding SessionDrawer.Clips.Count, Mode=OneWay, Converter={StaticResource ClipCount}}"/><Run Text=" · "/><Run Text="{Binding SessionDrawer.TotalSizeBytes, Mode=OneWay, Converter={StaticResource BytesToSize}}"/>
                            </TextBlock>
                            <TextBlock Text=" · ⏸ capture paused" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}"
                                       Visibility="{Binding IsCapturePaused, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📋" Style="{StaticResource IconButton}"
                                ToolTip="Paste the clipboard into this session (Ctrl+V)"
                                Command="{Binding PasteCommand}"/>
                        <Button Content="🧹" Style="{StaticResource DangerIconButton}"
                                ToolTip="Delete all open clips"
                                Command="{Binding ClearDrawerCommand}"
                                CommandParameter="{Binding SessionDrawer}"/>
                        <Button Content="➕ Drawer" Style="{StaticResource AccentButton}"
                                ToolTip="Start a new drawer" Margin="4,0,0,0"
                                Command="{Binding NewDrawerCommand}"/>
                    </StackPanel>
                </Grid>
                <!-- Usage thermometer: how full the current drawer is (clips/size vs. limits) -->
                <ProgressBar Style="{StaticResource UsageBar}" Margin="0,8,0,0"
                             DataContext="{Binding SessionDrawer}"
                             Value="{Binding UsageFraction, Mode=OneWay}"
                             Foreground="{Binding UsageFraction, Converter={StaticResource UsageToBrush}}"
                             ToolTip="How full this drawer is — fills green→red as it nears its clip/size limit"/>
            </StackPanel>
        </Border>

        <!-- ===== Search ===== -->
        <Border Grid.Row="2" Margin="12,2,12,6" Background="#FF20242C"
                BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Grid Grid.Column="1">
                    <TextBox Style="{StaticResource GhostTextBox}" FontSize="12" VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Search every drawer…" FontSize="12" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
                <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}"
                        Width="20" Height="20" FontSize="9" ToolTip="Clear search"
                        Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </Border>

        <!-- ===== Clip lists ===== -->
        <Grid Grid.Row="3">
            <!-- Session clips (hidden while searching) -->
            <Grid Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVis}}">
                <ListBox Style="{StaticResource FlatListBox}"
                         ItemContainerStyle="{StaticResource PlainItemStyle}"
                         ItemTemplate="{StaticResource ClipCardTemplate}"
                         ItemsSource="{Binding SessionDrawer.Clips}"
                         Padding="12,4,12,4"/>
                <TextBlock Foreground="{StaticResource SubTextBrush}" FontSize="12" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="30,60,30,0" IsHitTestVisible="False"
                           Visibility="{Binding SessionDrawer.Clips.Count, Converter={StaticResource ZeroToVisible}}">
                    <Run Text="Copy anything and it shows up here.&#10;Drop files here to clip them directly.&#10;&#10;"/><Run Text="{Binding HotkeyGesture, Mode=OneWay}"/><Run Text=" summons the sidebar from anywhere."/>
                </TextBlock>
            </Grid>

            <!-- Search results -->
            <Grid Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                <ListBox Style="{StaticResource FlatListBox}"
                         ItemContainerStyle="{StaticResource PlainItemStyle}"
                         ItemTemplate="{StaticResource SearchHitTemplate}"
                         ItemsSource="{Binding SearchResults}"
                         Padding="12,4,12,4"/>
                <TextBlock Text="No clips match."
                           Foreground="{StaticResource SubTextBrush}" FontSize="12" TextAlignment="Center"
                           Margin="30,60,30,0" IsHitTestVisible="False"
                           Visibility="{Binding SearchResults.Count, Converter={StaticResource ZeroToVisible}}"/>
            </Grid>
        </Grid>

        <!-- ===== Drawers section ===== -->
        <Border Grid.Row="4" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,1,0,0"
                Background="{StaticResource BgBrush}" Padding="12,8,12,10">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}">
                        <Run Text="DRAWERS ("/><Run Text="{Binding Drawers.Count, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                    <TextBlock Text="drag clips here to file them" FontSize="9"
                               Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ListBox Style="{StaticResource FlatListBox}"
                         ItemContainerStyle="{StaticResource PlainItemStyle}"
                         ItemTemplate="{StaticResource DrawerRowTemplate}"
                         ItemsSource="{Binding Drawers}"
                         MaxHeight="190"/>
                <TextBlock Text="No drawers yet — click ➕ Drawer to file clips by project."
                           FontSize="10" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap"
                           Visibility="{Binding Drawers.Count, Converter={StaticResource ZeroToVisible}}"/>
            </StackPanel>
        </Border>

        <!-- ===== Reel view overlay (open drawer) ===== -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource PanelBrush}"
                Visibility="{Binding OpenDrawer, Converter={StaticResource NullToVis}}">
            <Grid DataContext="{Binding OpenDrawer}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgBrush}" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="←" Style="{StaticResource IconButton}" ToolTip="Back to sidebar"
                                Command="{Binding DataContext.CloseReelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBox x:Name="ReelNameBox" Style="{StaticResource GhostTextBox}" FontSize="14" FontWeight="SemiBold"
                                     ToolTip="Click to rename"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock FontSize="10" Foreground="{StaticResource SubTextBrush}">
                                <Run Text="{Binding Clips.Count, Mode=OneWay, Converter={StaticResource ClipCount}}"/><Run Text=" · "/><Run Text="{Binding TotalSizeBytes, Mode=OneWay, Converter={StaticResource BytesToSize}}"/>
                            </TextBlock>
                            <ProgressBar Style="{StaticResource UsageBar}" Margin="0,5,0,0"
                                         Value="{Binding UsageFraction, Mode=OneWay}"
                                         Foreground="{Binding UsageFraction, Converter={StaticResource UsageToBrush}}"
                                         ToolTip="How full this drawer is — fills green→red as it nears its clip/size limit"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="📋" Style="{StaticResource IconButton}"
                                ToolTip="Paste the clipboard into this drawer (Ctrl+V)"
                                Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Grid.Column="3" Content="🧹" Style="{StaticResource DangerIconButton}"
                                ToolTip="Clear all clips in this drawer"
                                Command="{Binding DataContext.ClearDrawerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                        <Button Grid.Column="4" Content="🗑" ToolTip="Delete this drawer"
                                Command="{Binding DataContext.DeleteDrawerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerIconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSession}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource BgBrush}" Padding="12,0,12,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Max clips" FontSize="10" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource FieldTextBox}" Width="48" FontSize="11" Margin="6,0,14,0"
                                 Text="{Binding MaxClips, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Max MB" FontSize="10" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource FieldTextBox}" Width="48" FontSize="11" Margin="6,0,14,0"
                                 Text="{Binding MaxSizeMB, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="new copies land in this drawer" FontSize="10"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Film strip -->
                <Border Grid.Row="2" Background="{StaticResource FilmBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{StaticResource SprocketBrush}"/>
                        <ListBox Grid.Column="1"
                                 Style="{StaticResource FlatListBox}"
                                 ItemContainerStyle="{StaticResource PlainItemStyle}"
                                 ItemTemplate="{StaticResource ClipCardTemplate}"
                                 ItemsSource="{Binding Clips}"
                                 Padding="10,10,10,10"/>
                        <Rectangle Grid.Column="2" Fill="{StaticResource SprocketBrush}"/>
                        <TextBlock Grid.Column="1" Text="This drawer is empty.&#10;Copy something while it's open, or drop files here."
                                   Foreground="{StaticResource SubTextBrush}" FontSize="12" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="30,60,30,0" IsHitTestVisible="False"
                                   Visibility="{Binding Clips.Count, Converter={StaticResource ZeroToVisible}}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Settings overlay ===== -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="{StaticResource PanelBrush}"
                Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BgBrush}" Padding="8">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="←" Style="{StaticResource IconButton}" ToolTip="Back"
                                Command="{Binding ToggleSettingsCommand}"/>
                        <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="16,14">
                    <CheckBox IsChecked="{Binding PersistClips}" Foreground="{StaticResource TextBrush}" FontSize="12"
                              Content="Save clips between sessions"/>
                    <TextBlock Text="When on, every drawer (including the current session) is saved automatically. Turning it off removes saved clips from disk."
                               FontSize="10" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="20,4,0,16"/>

                    <CheckBox IsChecked="{Binding ReserveDesktopSpace}" Foreground="{StaticResource TextBrush}" FontSize="12"
                              Content="Reserve desktop space (dock)"/>
                    <TextBlock Text="Docks the sidebar to the screen edge as a true AppBar — other apps, even maximized ones, tile beside it instead of underneath. Turn off to float on top."
                               FontSize="10" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="20,4,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="WIDTH" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SidebarWidth, StringFormat={}{0:0} px}" FontSize="10"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <Slider Minimum="300" Maximum="640" TickFrequency="20" IsSnapToTickEnabled="True"
                            Value="{Binding SidebarWidth, Mode=TwoWay}" Margin="0,0,0,16"/>

                    <TextBlock Text="DEFAULTS FOR NEW DRAWERS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBlock Text="Max clips" FontSize="11" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource FieldTextBox}" Width="52" FontSize="11" Margin="6,0,16,0"
                                 Text="{Binding DefaultMaxClips, UpdateSourceTrigger=LostFocus}"/>
                        <TextBlock Text="Max MB" FontSize="11" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                        <TextBox Style="{StaticResource FieldTextBox}" Width="52" FontSize="11" Margin="6,0,0,0"
                                 Text="{Binding DefaultMaxSizeMB, UpdateSourceTrigger=LostFocus}"/>
                    </StackPanel>

                    <TextBlock Text="HOTKEY" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource FieldTextBox}" Width="150" FontSize="12"
                                 IsReadOnly="True" Cursor="Hand" CaretBrush="Transparent"
                                 Text="{Binding HotkeyGesture, Mode=OneWay}"
                                 ToolTip="Click here, then press the new key combination"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                        <TextBlock Text="click, then press a new combo" FontSize="10"
                                   Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Shows or hides the sidebar from anywhere. Needs at least one modifier (Ctrl/Alt/Shift/Win)."
                               FontSize="10" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="⚠ The hotkey could not be registered (another app owns it)."
                               FontSize="11" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HotkeyRegistered}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="DAW BRIDGE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SubTextBrush}" Margin="0,20,0,6"/>
                    <TextBlock Text="Most DAWs never put audio on the clipboard — so watch the folders they export to instead. New audio files landing in a watched folder (subfolders included) are clipped automatically once the DAW finishes writing them."
                               FontSize="10" Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding WatchedFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource EdgeBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding}"/>
                                        <Button Grid.Column="1" Content="✕" Style="{StaticResource DangerIconButton}"
                                                Width="22" Height="22" FontSize="10" ToolTip="Stop watching"
                                                Command="{Binding DataContext.RemoveWatchedFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="➕ Watch a folder" Style="{StaticResource AccentButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding AddWatchedFolderCommand}"/>

                    <Button Content="Quit Clip Yourself" Style="{StaticResource DangerButton}"
                            HorizontalAlignment="Left" Margin="0,26,0,0"
                            Command="{Binding ExitCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Drop-to-clip overlay ===== -->
        <Border x:Name="DropOverlay" Grid.Row="0" Grid.RowSpan="5" Background="#CC14161A"
                IsHitTestVisible="False" Visibility="Collapsed">
            <Grid>
                <Rectangle Margin="10" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                           StrokeDashArray="5 3" RadiusX="10" RadiusY="10"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📎" FontSize="34" TextAlignment="Center"/>
                    <TextBlock Text="Drop to clip" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextAlignment="Center" Margin="0,8,0,2"/>
                    <TextBlock Text="drop on a drawer row to file it there" FontSize="11"
                               Foreground="{StaticResource SubTextBrush}" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Status toast ===== -->
        <Border Grid.Row="0" Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,20" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1" CornerRadius="14" Padding="14,6" IsHitTestVisible="False"
                Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextBrush}"/>
        </Border>
    </Grid>
</Window>
