<UserControl x:Class="ClipYourself.Desktop.Controls.VideoPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxHeight="160" HorizontalAlignment="Left">
    <Border Background="#FF000000" CornerRadius="6" ClipToBounds="True">
        <Grid>
            <MediaElement x:Name="Media"
                          LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          ScrubbingEnabled="True" Stretch="Uniform"
                          MinWidth="120" MinHeight="72"
                          MediaOpened="Media_MediaOpened"
                          MediaEnded="Media_MediaEnded"
                          MediaFailed="Media_MediaFailed"/>

            <!-- A real Button so the click plays instead of bubbling to the card's copy action -->
            <Button x:Name="Surface" Click="Surface_Click" Cursor="Hand" Focusable="False"
                    ToolTip="Play / pause">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <Border x:Name="PlayBadge" Width="42" Height="42" CornerRadius="21" Background="#99000000">
                    <TextBlock x:Name="PlayGlyph" Text="▶" FontSize="16" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </Border>
            </Button>

            <TextBlock x:Name="TimeText" Text="" FontSize="10" Foreground="White" IsHitTestVisible="False"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4"
                       Background="#88000000" Padding="4,1"/>

            <StackPanel x:Name="Fallback" Visibility="Collapsed" IsHitTestVisible="False" Margin="16"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🎬" FontSize="24" TextAlignment="Center"/>
                <TextBlock Text="preview unavailable" FontSize="10" Foreground="#FF9AA3B2"
                           TextAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="(codec not installed — the file still copies)" FontSize="9"
                           Foreground="#FF9AA3B2" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="150"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
