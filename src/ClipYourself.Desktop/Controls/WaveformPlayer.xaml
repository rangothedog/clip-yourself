<UserControl x:Class="ClipYourself.Desktop.Controls.WaveformPlayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="58">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="PlayButton"
                Width="30" Height="30"
                VerticalAlignment="Center"
                Click="PlayButton_Click"
                Cursor="Hand"
                Focusable="False"
                ToolTip="Play / pause">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="#FF2D3440" CornerRadius="15">
                        <TextBlock x:Name="Glyph" Text="▶" FontSize="12" Foreground="#FFE8EAED"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#FF4F8CFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#FF20242C" CornerRadius="4" ClipToBounds="True">
                <Grid x:Name="WaveGrid" Cursor="Hand" Background="Transparent"
                      MouseLeftButtonDown="WaveGrid_MouseLeftButtonDown">
                    <Rectangle x:Name="ProgressRect" HorizontalAlignment="Left" Width="0" Fill="#334F8CFF"/>
                    <Polygon x:Name="WavePolygon" Stretch="Fill" Fill="#FF4F8CFF" Opacity="0.85" Margin="3"/>
                    <TextBlock x:Name="FallbackText" Text="waveform unavailable" FontSize="10"
                               Foreground="#FF9AA3B2" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <TextBlock x:Name="TimeText" Grid.Row="1" Text="" FontSize="10"
                       Foreground="#FF9AA3B2" Margin="1,3,0,0"/>
        </Grid>
    </Grid>
</UserControl>
