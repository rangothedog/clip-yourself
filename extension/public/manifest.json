{
  "manifest_version": 3,
  "name": "Clip Yourself",
  "version": "0.1.0",
  "description": "Collect text, image, and audio clips as you browse and copy them back later from the Chrome side panel.",
  "permissions": ["storage", "contextMenus", "sidePanel", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Clip Yourself"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
